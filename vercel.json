{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.neda.page" }],
      "destination": "https://neda.page/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nedath.vercel.app" }],
      "destination": "https://neda.page/:path*",
      "permanent": true
    }
  ]
}
