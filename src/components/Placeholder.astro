---
interface Props {
  /** Facts still missing, one per line. */
  items: string[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <aside class="placeholder" aria-label="Missing content">
    <p class="label">To add before launch</p>
    <ul>
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </aside>
)}
