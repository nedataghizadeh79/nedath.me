---
import { defaultRegister, registers } from '../data/site';
---

<div class="switch" role="group" aria-labelledby="read-as">
  <span id="read-as" class="label">Read as</span>
  {registers.map((r) => (
    <button
      type="button"
      data-register={r.id}
      aria-pressed={r.id === defaultRegister ? 'true' : 'false'}
    >
      {r.label}
    </button>
  ))}
</div>

<style>
  .switch { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-4); }
  button {
    position: relative;
    border: 0;
    background: none;
    padding: var(--space-1) 0;
    font-family: var(--f-mono);
    font-size: var(--t-sm);
    color: var(--quiet);
    cursor: pointer;
  }
  button:hover { color: var(--ink); }
  /* The chosen reading gets a blue-pencil dot and underline. */
  button[aria-pressed='true'] { color: var(--pencil); box-shadow: inset 0 -1.5px 0 var(--pencil); }
  button[aria-pressed='true']::before {
    content: '';
    position: absolute;
    left: -0.6rem;
    top: 50%;
    width: 4px;
    height: 4px;
    margin-top: -2px;
    border-radius: 50%;
    background: var(--pencil);
  }
</style>
