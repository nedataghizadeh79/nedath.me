---
/**
 * The one page header every inner page shares: a mono label, a large serif
 * title underlined in blue pencil, an optional lead, and an optional aside
 * (slot "aside", e.g. a photo print). Extra content goes in the default slot.
 */
import PencilMark from './PencilMark.astro';

interface Props {
  label: string;
  title: string;
  lead?: string;
}

const { label, title, lead } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<header class:list={['page-header', { 'has-aside': hasAside }]}>
  <div class="text">
    <p class="label">{label}</p>
    <h1>
      <span class="title">{title}<PencilMark kind="underline" class="pencil--load title-mark" style="--delay: 250ms" /></span>
    </h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
  {hasAside && <div class="aside"><slot name="aside" /></div>}
</header>

<style>
  .page-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    padding-block: var(--space-8) var(--space-7);
    align-items: start;
  }
  .page-header.has-aside { grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem); }
  .text { display: grid; gap: var(--space-4); justify-items: start; max-width: 52rem; }
  h1 {
    font-size: var(--t-title);
    font-weight: 350;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .title { position: relative; }
  .title :global(.title-mark) { position: absolute; left: 0; bottom: -0.22em; width: min(100%, 9em); height: 0.28em; }
  .lead { font-family: var(--f-voice); font-size: var(--t-lg); line-height: 1.3; color: var(--quiet); max-width: 40ch; }
  .aside { padding-top: var(--space-5); }
  @media (max-width: 52rem) {
    .page-header.has-aside { grid-template-columns: minmax(0, 1fr); }
    .aside { max-width: 17rem; padding-top: 0; }
  }
</style>
