---
import SourceLinks from './SourceLinks.astro';
import type { Project } from '../data/work';

interface Props {
  project: Project;
  /** Heading level for the title, to keep the outline correct where the row is used. */
  level?: 'h2' | 'h3';
}

const { project: p, level = 'h3' } = Astro.props;
const Heading = level;
const href = p.caseStudy ? `/work/${p.slug}/` : undefined;
---

<li class="row" data-roles={p.roles.join(' ')} data-type={p.type}>
  <span class="code" aria-hidden="true">{p.code}</span>
  <div class="body">
    <Heading class="title">
      {href ? <a href={href}>{p.title}</a> : p.title}
    </Heading>
    <p class="meta">{p.org} · <span class="tabular">{p.years}</span> · {p.type}</p>
    <p class="summary">{p.summary}</p>
    <SourceLinks sources={p.sources} id={`src-${p.slug}`} />
  </div>
  {href && <a class="read" href={href} aria-hidden="true" tabindex="-1">Case study →</a>}
</li>

<style>
  .row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5);
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }
  .code { font-family: var(--f-mono); font-size: var(--t-xs); color: var(--pencil); letter-spacing: 0.04em; }
  .body { display: grid; gap: var(--space-2); }
  .title { font-family: var(--f-voice); font-size: var(--t-lg); font-weight: 450; line-height: 1.2; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { text-decoration: underline; text-decoration-color: var(--pencil); }
  .meta { font-family: var(--f-mono); font-size: var(--t-xs); color: var(--quiet); }
  .summary { max-width: 60ch; }
  .read { font-size: var(--t-sm); font-weight: 600; white-space: nowrap; text-decoration: none; }
  @media (max-width: 44rem) {
    .row { grid-template-columns: minmax(0, 1fr); }
    .read { display: none; }
  }
</style>
