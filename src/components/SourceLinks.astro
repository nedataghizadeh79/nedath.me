---
import type { Source } from '../data/work';

interface Props {
  sources: Source[];
  /** Prefix for preview ids, unique per list on the page. */
  id: string;
}

const { sources, id } = Astro.props;
---

{sources.length > 0 && (
  <ul role="list" class="sources">
    {sources.map((s, i) => (
      <li class="source">
        <a href={s.href} target="_blank" rel="noopener" aria-describedby={`${id}-${i}`}>
          {s.label} <span aria-hidden="true">↗</span>
        </a>
        <span class="preview" role="tooltip" id={`${id}-${i}`}>{s.note} (opens in a new tab)</span>
      </li>
    ))}
  </ul>
)}

<style>
  .sources { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .source { position: relative; }
  .source a { font-family: var(--f-mono); font-size: var(--t-sm); white-space: nowrap; }
  /*
   * Text-only link preview: says where a link goes before you click.
   * display:none while closed, so it never widens the page.
   */
  .preview {
    display: none;
    position: absolute;
    left: 0;
    bottom: calc(100% + 6px);
    width: max-content;
    max-width: min(18rem, 80vw);
    padding: var(--space-2) var(--space-3);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--t-xs);
    line-height: 1.45;
    border-radius: 2px;
    pointer-events: none;
    z-index: 5;
  }
  .source:hover .preview, .source:focus-within .preview { display: block; animation: rise 150ms var(--ease); }
  @keyframes rise { from { opacity: 0; transform: translateY(3px); } }
  @media (hover: none) { .source:hover .preview, .source:focus-within .preview { display: none; } }
</style>
