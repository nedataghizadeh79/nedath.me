---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Placeholder from '../components/Placeholder.astro';
import PencilMark from '../components/PencilMark.astro';
import Print from '../components/Print.astro';
import { homePhoto } from '../data/album';
import { cvFile, intro, person } from '../data/site';
import { featured } from '../data/work';

const [resting, ...rewrites] = intro.edits;
const [beforeCircle, afterCircle] = intro.lead.split(intro.circled);
/** The full statement for screen readers, without the animation. */
const spoken = `${intro.lead} ${resting.replace(/\.$/, '')}, ${rewrites.map((w) => w.replace(/\.$/, '')).join(' and ')}.`;
---

<Base description="Frontend developer in Bonn building React and TypeScript interfaces, who also designs them and works closely with the people who use them.">
  <section class="hero" aria-labelledby="intro">
    <h1 id="intro" class="label byline">{person.name} · {person.role} · {person.location}</h1>

    <p class="statement">
      <span class="visually-hidden">{spoken}</span>
      <span aria-hidden="true">
        {beforeCircle}<span class="circled">{intro.circled}<PencilMark kind="circle" class="pencil--load circle-mark" style="--delay: 400ms" /></span>{afterCircle}
        <span class="edit" data-edits={JSON.stringify(intro.edits)}>
          <span class="old">{resting}</span><span class="insert"><span class="caret">‸</span><span class="hand"></span></span>
        </span>
      </span>
    </p>

    <div class="story">
      {intro.story.map((para) => <p>{para}</p>)}
      <p class="art">{intro.art.text} <a href={intro.art.href}>{intro.art.link} →</a></p>
    </div>

    <div class="portrait">
      <Print src={homePhoto.src} alt={homePhoto.alt} tilt={2.2} sizes="(min-width: 60rem) 22rem, 40vw" loading="eager" />
    </div>

    <div class="margin-note">
      <PencilMark kind="arrow" class="note-arrow" />
      <p class="note">{intro.note}</p>
      <button type="button" class="pause" data-pause aria-pressed="false">Pause edits</button>
    </div>

    <ol role="list" class="proofs" aria-label="Evidence">
      {intro.proofs.map((proof) => <li><PencilMark kind="check" class="tick" />{proof}</li>)}
    </ol>

    <div class="after">
      <p class="now">
        Front-end developer at ZB MED and M.Sc. Computer Science student at the University of Bonn, graduating September 2027.
      </p>
      <Placeholder items={['What you are looking for and from when: e.g. working student now, full-time from autumn 2027']} />
      <div class="actions">
        <a class="button button--primary" href={cvFile.href} download>Download CV</a>
        <a class="button" href="#contact">Contact</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="selected">
    <div class="head">
      <h2 id="selected">Selected work <PencilMark kind="underline" class="head-mark" /></h2>
      <a href="/work/">The full index →</a>
    </div>
    <ul role="list">
      {featured.map((p) => <ProjectRow project={p} />)}
    </ul>
  </section>
</Base>

<script>
  import { startEdits } from '../scripts/edits';
  startEdits();
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--space-5);
    padding-block: var(--space-7) var(--space-8);
  }
  .byline { grid-column: 1 / -1; margin-bottom: var(--space-6); }

  .statement {
    grid-column: 1 / 9;
    grid-row: 2;
    z-index: 2;
    font-family: var(--f-voice);
    font-size: var(--t-hero);
    font-weight: 350;
    line-height: 1.42;
    letter-spacing: -0.03em;
    padding-top: var(--space-4);
  }
  /* A clear word space before the edited words, so the strike never touches "into". */
  .edit { position: relative; display: inline-block; white-space: nowrap; margin-inline-start: 0.28em; }
  .old { position: relative; display: inline-block; }
  /* The strike: a blue-pencil line drawn through the old words. */
  .old::after {
    content: '';
    position: absolute;
    left: -1%;
    top: 54%;
    height: 0.07em;
    width: 103%;
    background: var(--pencil);
    border-radius: 2px;
    transform: rotate(-2deg) scaleX(0);
    transform-origin: left center;
    transition: transform 420ms var(--ease);
  }
  .edit.is-striking .old::after { transform: rotate(-2deg) scaleX(1); }
  .edit.is-striking .old { color: var(--quiet); transition: color 420ms; }
  /* The insertion: a caret under the line and the new words written above. */
  .insert {
    position: absolute;
    left: 0;
    bottom: 74%;
    display: flex;
    align-items: flex-end;
    gap: 0.1em;
    font-family: var(--f-hand);
    font-size: 0.62em;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--pencil);
    white-space: nowrap;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 700ms var(--ease);
    pointer-events: none;
  }
  .caret { font-family: var(--f-voice); font-size: 0.8em; transform: translateY(0.9em); }
  .edit.is-writing .insert { clip-path: inset(-20% -5% -40% -5%); }

  .portrait {
    grid-column: 9 / -1;
    grid-row: 2 / 4;
    align-self: start;
    margin-top: var(--space-4);
  }
  .circled { position: relative; display: inline-block; }
  .circled :global(.circle-mark) { position: absolute; left: -5%; top: 8%; width: 110%; height: 92%; }

  .margin-note { grid-column: 9 / -1; grid-row: 4; position: relative; padding-top: var(--space-4); display: grid; gap: var(--space-3); justify-items: start; }
  /* The arrow points from the note up to the photo. */
  .margin-note :global(.note-arrow) { position: absolute; left: 2.5rem; top: -1.6rem; width: 3.2rem; height: 1.8rem; transform: rotate(-62deg); }
  .margin-note { padding-top: var(--space-6); }
  .pause {
    border: 0;
    background: none;
    padding: var(--space-1) 0;
    font-family: var(--f-mono);
    font-size: var(--t-xs);
    color: var(--quiet);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  /* The first impression: who I am, right under the statement. */
  .story {
    grid-column: 1 / 8;
    grid-row: 3;
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-5);
    font-size: var(--t-md);
    line-height: 1.6;
    max-width: 60ch;
  }
  .art { font-family: var(--f-voice); font-style: italic; }
  .art a { font-style: normal; font-family: var(--f-hand); font-size: 1.45em; white-space: nowrap; }
  .proofs {
    grid-column: 1 / 8;
    grid-row: 4 / 6;
    margin-top: var(--space-7);
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-4);
    max-width: 58ch;
  }
  .proofs li { display: grid; grid-template-columns: 2.5rem 1fr; align-items: start; }
  /* Each proof gets an editor's check mark: checked, true. */
  .proofs :global(.tick) { width: 1.4rem; height: 1.2rem; margin-top: 0.15em; }

  .after { grid-column: 1 / 8; display: grid; gap: var(--space-4); margin-top: var(--space-6); }
  .now { color: var(--quiet); max-width: 58ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-5); }
  .head h2 { position: relative; font-size: var(--t-xxl); }
  .head :global(.head-mark) { position: absolute; left: 0; bottom: -0.35em; width: 100%; height: 0.4em; }
  .head a { font-size: var(--t-sm); font-weight: 600; }

  @media (max-width: 60rem) {
    .hero { grid-template-columns: minmax(0, 1fr) 9rem; column-gap: var(--space-4); }
    .byline { grid-column: 1 / -1; }
    .byline { margin-bottom: var(--space-3); }
    .statement { grid-column: 1 / -1; grid-row: 2; padding-top: var(--space-6); }
    .portrait { grid-column: 2; grid-row: 3; margin-top: var(--space-6); }
    .margin-note { grid-column: 1; grid-row: 3; align-self: end; padding: 0 0 var(--space-3); }
    .margin-note :global(.note-arrow) { display: none; }
    .story, .proofs, .after { grid-column: 1 / -1; grid-row: auto; }
    .proofs { margin-top: var(--space-6); }
  }
</style>
