---
/**
 * Source for the social preview image (public/og.png).
 * Rendered at 1200×630 by `npm run render`; not linked from the site.
 */
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/nanum-pen-script/latin-400.css';
import '../styles/global.css';
import { intro, person } from '../data/site';
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Preview image</title>
  </head>
  <body>
    <div class="card">
      <p class="label">{person.name} · {person.role} · {person.location}</p>
      <p class="statement">{intro.lead} <span class="old">{intro.edits[0]}</span></p>
      <p class="foot"><span class="hand">{intro.note}</span><span class="url">nedath.me</span></p>
    </div>
  </body>
</html>

<style>
  body { margin: 0; }
  .card {
    width: 1200px;
    height: 630px;
    padding: 72px 80px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 32px;
    background: var(--paper);
    color: var(--ink);
  }
  .label { font-size: 18px; }
  .statement { font-family: var(--f-voice); font-size: 84px; line-height: 1; letter-spacing: -0.02em; max-width: 24ch; align-self: center; }
  .foot { font-family: var(--f-mono); font-size: 20px; color: var(--pencil); display: flex; align-items: center; gap: 16px; }
  .url { margin-left: auto; color: var(--ink); }
  .old { color: var(--pencil); }
  .hand { font-family: var(--f-hand); font-size: 40px; transform: rotate(-2deg); }
</style>
