---
/**
 * The CV page shows the real CV as one long sheet of paper on the desk.
 * The image is the PDF in public/ rendered with `pdftoppm -r 220 -png`, with both pages
 * joined into one and the empty white at the page break and the end cut away.
 * Make it again when the PDF changes.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { cvFile, person } from '../data/site';
import sheet from '../assets/cv/cv.png';
---

<Base title="CV" crumbs={[{ name: 'CV', path: '/cv/' }]} description="CV of Neda Taghizade Serajeh: front-end developer (React, TypeScript), UI/UX designer and ServiceNow Certified System Administrator, M.Sc. Computer Science, University of Bonn.">
  <PageHeader label="CV" title="Curriculum vitae" lead="My full CV. Open the PDF to use the links in it.">
    <div class="actions">
      <a class="button button--primary" href={cvFile.href} download>Download PDF</a>
      <a class="button" href={cvFile.href} target="_blank" rel="noopener">Open PDF<span class="visually-hidden"> (opens in a new tab)</span></a>
    </div>
  </PageHeader>

  <a class="sheets" href={cvFile.href} target="_blank" rel="noopener" aria-label="The CV, open the PDF in a new tab">
    <Image
      class="sheet"
      src={sheet}
      alt={`The CV of ${person.name}`}
      widths={[700, 1000, 1400, 1819]}
      sizes="(min-width: 56rem) 52rem, 100vw"
      loading="eager"
    />
  </a>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .sheets { display: block; max-width: 52rem; margin-inline: auto; margin-bottom: calc(2 * var(--space-8)); cursor: zoom-in; }
  /* The CV lies on the desk like one printed sheet. */
  .sheets :global(.sheet) {
    display: block;
    width: 100%;
    height: auto;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08), 0 18px 40px -16px rgb(0 0 0 / 0.3);
  }
</style>
