---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page does not exist.">
  <section class="lost stack" style="--gap: var(--space-4)">
    <p class="label">404</p>
    <h1>This page isn’t in the index.</h1>
    <p>The link may be old or mistyped. Try the <a href="/work/">Work index</a> or go back to the <a href="/">home page</a>.</p>
  </section>
</Base>

<style>
  .lost { padding-block: var(--space-9); max-width: 40ch; }
  h1 { font-size: var(--t-xxl); }
</style>
