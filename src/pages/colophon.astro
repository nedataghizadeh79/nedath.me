---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

/** Colour tokens shown on this page, read from the same names the CSS uses. */
const tokens = [
  { name: '--paper', role: 'Background' },
  { name: '--ink', role: 'Text' },
  { name: '--quiet', role: 'Secondary text' },
  { name: '--pencil', role: 'The one accent: links, edits, notes' },
  { name: '--mark', role: 'Highlighter' },
];

const faces = [
  { family: 'var(--f-voice)', name: 'Newsreader', use: 'Headings and statements' },
  { family: 'var(--f-ui)', name: 'Schibsted Grotesk', use: 'Interface and body text' },
  { family: 'var(--f-mono)', name: 'IBM Plex Mono', use: 'Labels and dates' },
  { family: 'var(--f-hand)', name: 'Nanum Pen Script', use: 'Handwritten blue-pencil notes' },
];
---

<Base title="Colophon" crumbs={[{ name: 'Colophon', path: '/colophon/' }]} description="How this site is built: stack, design standards, accessibility and privacy.">
  <PageHeader label="Colophon" title="How this site is built" lead="A manuscript under edit. Blue pencil, the colour editors use for corrections, marks what matters: strikes, circles, underlines and handwritten notes." />

  <section class="section grid" aria-labelledby="stack">
    <h2 id="stack">Stack</h2>
    <ul class="list">
      <li><strong>Astro and TypeScript (strict).</strong> Static pages, no client framework. The only scripts are the live edit on the home page, the theme toggle, the email copy button and the Work filters.</li>
      <li><strong>Plain CSS</strong> with cascade layers and custom properties. No CSS framework.</li>
      <li><strong>Self-hosted fonts</strong> through Fontsource, so no requests go to third-party font servers.</li>
      <li><strong>Content as typed data.</strong> Projects, experience and skills live in TypeScript files; the pages and the CV are generated from them.</li>
      <li><strong>Hosted on Vercel</strong>, deployed from GitHub on every push.</li>
    </ul>
  </section>

  <section class="section grid" aria-labelledby="standards">
    <h2 id="standards">Design standards</h2>
    <div class="stack" style="--gap: var(--space-5)">
      <ul role="list" class="swatches">
        {tokens.map((t) => (
          <li><span class="swatch" style={`background: var(${t.name})`}></span><code>{t.name}</code><span>{t.role}</span></li>
        ))}
      </ul>
      <ul role="list" class="faces">
        {faces.map((f) => (
          <li><span class="specimen" style={`font-family: ${f.family}`}>Aa</span><strong>{f.name}</strong><span>{f.use}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section grid" aria-labelledby="a11y">
    <h2 id="a11y">Accessibility</h2>
    <ul class="list">
      <li>Built to WCAG 2.2 AA: colour contrast checked in both themes, visible keyboard focus, a skip link and semantic headings.</li>
      <li>The filters are real buttons with pressed states, and changes are announced to screen readers. The live edit has a pause button, and screen readers hear the full sentence instead.</li>
      <li>Motion is limited to the edit and pencil marks, and turns off when the system asks for reduced motion.</li>
      <li>Link previews are text, available to keyboard and screen-reader users as descriptions.</li>
    </ul>
  </section>

  <section class="section grid" aria-labelledby="privacy">
    <h2 id="privacy">Privacy</h2>
    <ul class="list">
      <li>No cookies, no analytics, no tracking.</li>
      <li>Your chosen theme is stored only in your own browser.</li>
      <li>The hosting provider keeps standard server logs.</li>
    </ul>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: 14rem minmax(0, 1fr); gap: var(--space-6); }
  h2 { font-size: var(--t-lg); }
  .list { display: grid; gap: var(--space-3); padding-left: 1.1em; max-width: var(--measure); }
  .swatches, .faces { display: grid; gap: var(--space-3); }
  .swatches li, .faces li { display: grid; grid-template-columns: 2.5rem 7rem minmax(0, 1fr); gap: var(--space-4); align-items: center; }
  .swatch { width: 2.5rem; height: 2.5rem; border: 1px solid var(--rule); border-radius: 50%; }
  .swatches span:last-child, .faces span:last-child { color: var(--quiet); font-size: var(--t-sm); }
  .specimen { font-size: 2rem; line-height: 1; }
  @media (max-width: 44rem) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .swatches li, .faces li { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .swatches span:last-child, .faces span:last-child { grid-column: 2; }
  }
</style>
